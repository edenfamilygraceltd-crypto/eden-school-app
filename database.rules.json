{
  "rules": {
    "branches": {
      "$branch": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('branch').val() === $branch || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('branch').val() === $branch || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        "students": {
          "$studentId": {
            ".read": "auth != null",
            ".write": "auth != null",
            "totalPaid": {
              ".write": "auth != null"
            }
          }
        },

        "payments": {
          "fees": {
            "$paymentId": {
              ".write": "auth != null && (!data.exists() || !newData.exists())"
            }
          },
          "coaching": {
            "$id": {
              ".write": "auth != null"
            }
          },
          "transport": {
            "$id": {
              ".write": "auth != null"
            }
          },
          "registration": {
            "$id": {
              ".write": "auth != null"
            }
          }
        },

        "payroll": {
          "$periodKey": {
            ".write": "auth != null && !data.exists()"
          }
        },

        "reports": {
          "daily": {
            "$dayKey": {
              ".write": "auth != null && !data.exists()"
            }
          },
          "weekly": {
            "$id": {
              ".write": "auth != null && !data.exists()"
            }
          },
          "monthly": {
            "$id": {
              ".write": "auth != null && !data.exists()"
            }
          },
          "openingBalances": {
            "$date": {
              ".write": "auth != null"
            }
          }
        },

        "workers": {
          "$id": {
            ".write": "auth != null"
          }
        },
        "classes": {
          ".write": "auth != null"
        },
        "feeConfig": {
          ".write": "auth != null"
        },
        "debts": {
          "$id": {
            ".write": "auth != null"
          }
        }
      }
    },

    "academic_documents": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["type", "uploadedAt"]
    },

    "global": {
      "settings": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "announcements": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id','participants','createdBy','createdAt'])"
      }
    },
    "notifications": {
      "$notificationId": {
        ".read": "auth != null && (data.child('to').val() === auth.uid || data.child('teacherId').val() === auth.uid || data.child('recipientId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('targetRole').val() === 'teacher')",
        ".write": "newData.hasChildren(['createdAt','type'])",
        ".indexOn": ["createdAt","teacherId","targetRole","to"]
      }
    },
    "inscriptions-scolaires": {
      ".read": false,
      ".write": "newData.hasChildren(['reference','nomPrenom','status','dateInscription','timestamp'])",
      ".indexOn": ["status","reference"]
    },
    "activities": {
      "$activityId": {
        ".read": "auth != null",
        ".write": "newData.hasChildren(['description','timestamp']) && !data.exists()"
      }
    }
  }
}