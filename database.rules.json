{
  "rules": {
    "branches": {
      "$branch": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('branch').val() === $branch || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('branch').val() === $branch || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        "students": {
          "$studentId": {
            ".read": "auth != null",
            ".write": "auth != null",
            "totalPaid": {
              ".write": "auth != null"
            }
          }
        },

        "payments": {
          "fees": {
            "$paymentId": {
              ".write": "auth != null && (!data.exists() || !newData.exists())"
            }
          },
          "coaching": {
            "$id": {
              ".write": "auth != null"
            }
          },
          "transport": {
            "$id": {
              ".write": "auth != null"
            }
          },
          "registration": {
            "$id": {
              ".write": "auth != null"
            }
          }
        },

        "payroll": {
          "$periodKey": {
            ".write": "auth != null && !data.exists()"
          }
        },

        "reports": {
          "daily": {
            "$dayKey": {
              ".write": "auth != null && !data.exists()"
            }
          },
          "weekly": {
            "$id": {
              ".write": "auth != null && !data.exists()"
            }
          },
          "monthly": {
            "$id": {
              ".write": "auth != null && !data.exists()"
            }
          },
          "openingBalances": {
            "$date": {
              ".write": "auth != null"
            }
          }
        },

        "workers": {
          "$id": {
            ".write": "auth != null"
          }
        },
        "classes": {
          ".write": "auth != null"
        },
        "feeConfig": {
          ".write": "auth != null"
        },
        "debts": {
          "$id": {
            ".write": "auth != null"
          }
        }
      }
    },

    "accountInvites": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'IT Admin')",
      "$token": {
        ".read": true,
        ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'IT Admin')) || (auth != null && data.exists() && !data.child('used').val() && newData.child('used').val() === true && newData.child('usedBy').val() === auth.uid)",
        ".validate": "newData.hasChildren(['type','name','email','role','niveau','branche','classeId','classe','createdAt','expiresAt','used']) && newData.child('type').val() === 'teacher'"
      }
    },

    "academic_documents": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["type", "uploadedAt"]
    },

    "global": {
      "settings": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "announcements": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id','participants','createdBy','createdAt'])"
      }
    },
    "notifications": {
      "$notificationId": {
        ".read": "auth != null && (data.child('to').val() === auth.uid || data.child('teacherId').val() === auth.uid || data.child('recipientId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('targetRole').val() === 'teacher')",
        ".write": "newData.hasChildren(['createdAt','type'])",
        ".indexOn": ["createdAt","teacherId","targetRole","to"]
      }
    },
    "inscriptions-scolaires": {
      ".read": false,
      ".write": "newData.hasChildren(['reference','nomPrenom','status','dateInscription','timestamp'])",
      ".indexOn": ["status","reference"]
    },
    "activities": {
      "$activityId": {
        ".read": "auth != null",
        ".write": "newData.hasChildren(['description','timestamp']) && !data.exists()"
      }
    },
    "lesson_preparations": {
      ".read": "auth != null && query.orderByChild === 'teacherUid' && query.equalTo === auth.uid",
      ".indexOn": ["teacherUid", "branch", "class"],
      "$recordId": {
        ".write": "auth != null && ((!data.exists() && newData.child('teacherUid').val() === auth.uid) || (data.exists() && data.child('teacherUid').val() === auth.uid && (!newData.exists() || newData.child('teacherUid').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['teacherUid','branch','class','subject','title','lessonDate','durationMinutes','objectives','materials','introduction','development','conclusion','assessment'])"
      }
    },
    "teacher_attendance": {
      "$teacherId": {
        ".read": "auth != null && (auth.uid === $teacherId || root.child('users').child(auth.uid).child('role').val() === 'director' || root.child('users').child(auth.uid).child('role').val() === 'Director' || root.child('users').child(auth.uid).child('role').val() === 'directeur' || root.child('users').child(auth.uid).child('role').val() === 'Directeur' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'administrateur' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || root.child('users').child(auth.uid).child('role').val() === 'Secretary' || root.child('users').child(auth.uid).child('role').val() === 'secretaire' || root.child('users').child(auth.uid).child('role').val() === 'Secr?taire')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'director' || root.child('users').child(auth.uid).child('role').val() === 'Director' || root.child('users').child(auth.uid).child('role').val() === 'directeur' || root.child('users').child(auth.uid).child('role').val() === 'Directeur' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'administrateur' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || root.child('users').child(auth.uid).child('role').val() === 'Secretary' || root.child('users').child(auth.uid).child('role').val() === 'secretaire' || root.child('users').child(auth.uid).child('role').val() === 'Secr?taire')"
      }
    }
  }
}