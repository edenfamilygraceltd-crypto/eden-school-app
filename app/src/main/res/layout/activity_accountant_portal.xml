<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/accountantRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F4F8F5">

    <ScrollView
        android:id="@+id/accountantNavigationContainer"
        android:layout_width="116dp"
        android:layout_height="match_parent"
        android:background="#1E6B4E"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">
            <ImageView
                android:id="@+id/accountantLogo"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/eden_logo"
                android:scaleType="fitCenter"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Afficher ou masquer le menu"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EDEN SMART"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingBottom="18dp"/>
            <LinearLayout
                android:id="@+id/accountantNavigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/accountantPageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tableau de bord"
                    android:textColor="#2F4F4F"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/accountantUserLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comptable"
                    android:textColor="#718078"
                    android:textSize="11sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/accountantLanguage"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="FR"
                android:textStyle="bold"
                android:textColor="#1E6B4E"
                android:background="#E8F4EC"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/accountantBranchSelector"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </HorizontalScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/accountantContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>