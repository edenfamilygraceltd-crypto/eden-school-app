<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/secretaryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECF0F1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EDEN FAMILY SCHOOL"
                    android:textColor="#2C3E50"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/secretaryUserLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Portail Secrétaire"
                    android:textColor="#7F8C8D"
                    android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/secretaryRefresh"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:text="Actualiser"
                android:textAllCaps="false"
                android:textColor="#2C3E50"
                app:strokeColor="#BDC3C7" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/secretaryLogout"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:text="Quitter"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#16A085" />
        </LinearLayout>

        <TextView
            android:id="@+id/secretaryBranchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E8F6F3"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="Branche : vérification..."
            android:textColor="#16A085"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2C3E50"
        android:fillViewport="false"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/secretaryNavigation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/secretaryContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/secretaryPageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tableau de bord"
                android:textColor="#2C3E50"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/secretaryPageDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Chargement de votre espace..."
                android:textColor="#7F8C8D"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/secretaryCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/secretaryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#7F8C8D"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/secretaryRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
