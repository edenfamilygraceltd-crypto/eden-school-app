{
  "projects": {
    "default": "edensmart-c7019"
  },
  "database": {
    "rules": "database.rules.json",
    "target": "edensmart-app"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}